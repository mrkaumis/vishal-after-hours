---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .sort(
    (a, b) =>
      b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  )
  .slice(0, 3);
---

<BaseLayout>
  <div class="container">

    <section class="hero">
      <p>VISHAL AFTER HOURS</p>

      <h1>Engineering thoughts after the workday.</h1>

      <p>
        Practical notes and deep dives into Java,
        AI, backend engineering, AWS and distributed systems.
      </p>
    </section>

    <section class="section">
      <h2 class="section-title">Latest Writing</h2>

      <div class="posts">
        {posts.map((post) => (
          <a class="post" href={`/blog/${post.id}`}>
            <div class="post-meta">
              {post.data.tags.join(" · ").toUpperCase()}
            </div>

            <div class="post-title">
              {post.data.title}
            </div>

            <div class="post-description">
              {post.data.description}
            </div>
          </a>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>