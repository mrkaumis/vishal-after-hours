---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .sort(
    (a, b) =>
      b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
---

<BaseLayout
  title="Blog — Vishal After Hours"
  description="Technical articles on Java, AI, backend engineering, AWS and distributed systems."
>
  <div class="container">

    <section class="hero">
      <p>TECHNICAL WRITING</p>

      <h1>Things I learn.</h1>

      <p>
        Practical notes and deep dives into Java,
        AI, backend engineering, AWS and distributed systems.
      </p>
    </section>

    <section class="section">
      <h2 class="section-title">All Articles</h2>

      <div class="posts">
        {posts.map((post) => (
          <a class="post" href={`/blog/${post.id}`}>
            <div class="post-meta">
              {post.data.tags.join(" · ").toUpperCase()}
            </div>

            <div class="post-title">
              {post.data.title}
            </div>

            <div class="post-description">
              {post.data.description}
            </div>

            <div class="post-meta">
              {post.data.pubDate.toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
            </div>
          </a>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>