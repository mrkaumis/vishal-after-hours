---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "About — Vishal After Hours";
const description =
  "About Vishal Mishra — Software Development Engineer working on backend engineering, Java, distributed systems, cloud and AI.";
---

<BaseLayout title={title} description={description}>
  <div class="container">

<section class="hero">
  <p>ABOUT ME</p>

  <h1>
    I build software, break things,
    understand why they broke,
    and write about it.
  </h1>

  <p>
    I'm Vishal Mishra, a Software Development Engineer
    working at United Airlines.
  </p>
</section>

<section class="section">
  <h2 class="section-title">What I Do</h2>

  <div class="posts">

    <div class="post">
      <div class="post-meta">BACKEND ENGINEERING</div>

      <div class="post-title">
        Building systems that work beyond the happy path.
      </div>

      <div class="post-description">
        I work primarily around backend engineering,
        designing APIs, services, integrations and systems
        that need to remain reliable as complexity grows.
      </div>
    </div>

    <div class="post">
      <div class="post-meta">JAVA & SPRING</div>

      <div class="post-title">
        Understanding what happens underneath the framework.
      </div>

      <div class="post-description">
        Java and Spring are a major part of my engineering
        toolkit. I enjoy going beyond surface level concepts
        and understanding what the framework is actually doing
        behind the scenes.
      </div>
    </div>

    <div class="post">
      <div class="post-meta">DISTRIBUTED SYSTEMS</div>

      <div class="post-title">
        Thinking about failures, scale and consistency.
      </div>

      <div class="post-description">
        I explore messaging, Kafka, transactions, caching,
        retries, idempotency, consistency and failure handling.
      </div>
    </div>

    <div class="post">
      <div class="post-meta">AWS & CLOUD</div>

      <div class="post-title">
        Turning software into production systems.
      </div>

      <div class="post-description">
        I work with cloud technologies and AWS while thinking
        about scalability, deployment, observability,
        reliability and the tradeoffs involved in running
        software in production.
      </div>
    </div>

    <div class="post">
      <div class="post-meta">AI</div>

      <div class="post-title">
        Exploring how AI changes software engineering.
      </div>

      <div class="post-description">
        I'm exploring AI from an engineering perspective:
        models, agents and AI powered systems integrated
        into real applications.
      </div>
    </div>

  </div>
</section>

<section class="section">
  <h2 class="section-title">At United Airlines</h2>

  <p class="article-description">
    I'm a Software Development Engineer at United Airlines,
    working on software systems where reliability,
    maintainability and engineering discipline matter.
  </p>

  <p class="article-description">
    Working in a large engineering organization exposes me
    to problems that don't usually appear in tutorials:
    service integrations, production failures, system
    behavior, scalability and maintaining software as it evolves.
  </p>

  <p class="article-description">
    That experience strongly influences what I write here.
    I prefer practical engineering over textbook definitions.
  </p>
</section>

<section class="section">
  <h2 class="section-title">Why Vishal After Hours?</h2>

  <p class="article-description">
    Most interesting engineering questions don't end when
    the workday ends.
  </p>

  <p class="article-description">
    Vishal After Hours is where I document those questions,
    experiments, lessons and rabbit holes.
  </p>

  <p class="article-description">
    The goal isn't to create another collection of
    copy pasted tutorials. It's about understanding concepts
    deeply, connecting them to real engineering problems and
    explaining them in a way that is useful to people building
    software.
  </p>
</section>

<section class="section">
  <h2 class="section-title">What You'll Find Here</h2>

  <div class="posts">

    <div class="post">
      <div class="post-meta">JAVA</div>
      <div class="post-title">
        Deep dives into Java and Spring
      </div>
    </div>

    <div class="post">
      <div class="post-meta">BACKEND</div>
      <div class="post-title">
        APIs, architecture and production problems
      </div>
    </div>

    <div class="post">
      <div class="post-meta">DISTRIBUTED SYSTEMS</div>
      <div class="post-title">
        Kafka, transactions, caching and consistency
      </div>
    </div>

    <div class="post">
      <div class="post-meta">AWS</div>
      <div class="post-title">
        Cloud architecture and engineering
      </div>
    </div>

    <div class="post">
      <div class="post-meta">AI</div>
      <div class="post-title">
        AI, agents and practical experimentation
      </div>
    </div>

  </div>
</section>

<section class="hero">
  <p>KEEP BUILDING</p>

  <h2>
    Learn something.
    Build something.
    Break something.
    Understand why.
  </h2>

  <p>Then write about it.</p>
</section>
```

  </div>
</BaseLayout>
